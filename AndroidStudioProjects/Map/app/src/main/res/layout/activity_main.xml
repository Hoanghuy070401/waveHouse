<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <TextureView
        android:id="@+id/filamentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_border_10"
            android:drawablePadding="8dp"
            android:padding="8dp"
            android:text="Tìm kiếm ở đây..."
            android:textColor="@color/black"
            app:drawableStartCompat="@drawable/ic_search" />

        <LinearLayout
            android:id="@+id/llButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:gravity="end"
            android:orientation="vertical">

            <!--            <org.maplibre.android.maps.widgets.CompassView-->
            <!--                android:id="@+id/PlayMap"-->
            <!--                android:layout_width="40dp"-->
            <!--                android:layout_height="40dp"-->
            <!--                android:layout_marginBottom="16dp"-->
            <!--                android:src="@drawable/ic_my_location"-->
            <!--                android:background="@drawable/bg_radius_10_dp"-->
            <!--                />-->

            <ImageView
                android:id="@+id/changeStyleMap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_radius_10_dp"
                android:padding="10dp"
                android:src="@drawable/ic_layer" />

            <ImageView
                android:id="@+id/location"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_radius_10_dp"
                android:padding="10dp"
                android:src="@drawable/ic_location" />

            <!--            <ImageView-->
            <!--                android:id="@+id/draw"-->
            <!--                android:layout_width="40dp"-->
            <!--                android:layout_height="40dp"-->
            <!--                android:layout_marginBottom="16dp"-->
            <!--                android:padding="10dp"-->
            <!--                android:background="@drawable/bg_radius_10_dp"-->
            <!--                android:src="@drawable/ic_drawble" />-->

            <!--            <ImageView-->
            <!--                android:id="@+id/clear"-->
            <!--                android:layout_width="40dp"-->
            <!--                android:layout_height="40dp"-->
            <!--                android:padding="10dp"-->
            <!--                android:background="@drawable/bg_radius_10_dp"-->
            <!--                android:src="@drawable/ic_clear" />-->

        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/llInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="35dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="@string/bottom_sheet_behavior"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Thông tin chi tiết"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/black"
            android:textSize="16sp" />
        <!--        <androidx.appcompat.widget.AppCompatTextView-->
        <!--            android:id="@+id/tvDistance"-->
        <!--            android:textColor="@color/black"-->
        <!--            android:textSize="16sp"-->
        <!--            android:layout_marginBottom="16dp"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"/>-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnDirections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_border_10"
                android:backgroundTint="@color/teal_700"
                android:drawablePadding="8dp"
                android:padding="10dp"
                android:text="Đường đi"
                android:textColor="@color/white"
                app:drawableStartCompat="@drawable/ic_directions_button"
                app:drawableTint="@color/white" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_border_10"
                android:backgroundTint="@color/teal_700"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="8dp"
                android:padding="10dp"
                android:text="Bắt đầu"
                android:textColor="@color/white"
                app:drawableStartCompat="@drawable/ic_directions_start"
                app:drawableTint="@color/white" />
        </LinearLayout>


        <!--  <LinearLayout-->
        <!--      android:id="@+id/llData"-->
        <!--      android:layout_width="match_parent"-->
        <!--      android:layout_height="wrap_content"-->
        <!--      android:orientation="vertical">-->


        <!--   <com.google.android.material.button.MaterialButton-->
        <!--       android:id="@+id/btnViewDetail"-->
        <!--       android:text="Chọn"-->
        <!--       android:layout_width="match_parent"-->
        <!--       android:layout_height="wrap_content" />-->
        <!--  </LinearLayout>-->


    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:visibility="gone" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>